# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public RevScale URL
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Used to generate one write-only web lead key per organization.
# Use a long random secret and never expose it in client-side code.
INTEGRATIONS_SIGNING_SECRET=replace-with-a-long-random-secret
