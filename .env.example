# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Backend-only key. Prefer the modern sb_secret_... key.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy fallback if needed:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public RevScale URL. The app already falls back to the production URL.
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Used to generate one write-only web lead key per organization.
# Use a long random secret and never expose it in client-side code.
INTEGRATIONS_SIGNING_SECRET=replace-with-a-long-random-secret

# After changing server secrets in Vercel, create a fresh deployment so the new values are loaded.
